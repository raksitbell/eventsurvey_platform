# Mock API and EventSurvey URL
MOCK_API_BASE_URL=https://eventmockapi.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://eventmockapi.vercel.app
# Optional for a separate demo-only dataset. Set to that mock API's exact base URL.
TRIAL_DEMO_API_BASE_URL=
APP_URL=http://localhost:3000

# Required session and invitation secret. Generate with openssl rand -hex 32.
AUTH_SESSION_SECRET=

# Optional Gmail SMTP for setup-password invitations
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=EventSurvey

# Optional separate stable encryption key for Event Setup (recommended for hosting).
# Generate with openssl rand -hex 32. If blank, AUTH_SESSION_SECRET is used.
EVENT_SETUP_DATA_SECRET=
# Optional override: blob or disk. Vercel uses Blob when a connected store provides BLOB_STORE_ID.
# Connect a private Blob store per environment using Vercel OIDC.
EVENT_SETUP_MEDIA_PROVIDER=
# Disk provider: absolute path to a persistent volume. Development defaults to .eventsurvey-media/.
EVENT_SETUP_MEDIA_DIR=
